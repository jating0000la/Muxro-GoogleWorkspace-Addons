{
  "name": "muxro-llm-connector",
  "version": "1.1.0",
  "description": "Local proxy server that bridges Google Workspace addons with Ollama or LM Studio LLM running on localhost",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "start:lmstudio": "LLM_BACKEND=lmstudio node server.js",
    "dev": "node server.js --verbose",
    "dev:lmstudio": "LLM_BACKEND=lmstudio node server.js --verbose"
  },
  "keywords": [
    "ollama",
    "lmstudio",
    "lm-studio",
    "google-workspace",
    "proxy",
    "llm",
    "google-sheets",
    "google-docs",
    "google-slides"
  ],
  "license": "MIT",
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.18.2"
  }
}
